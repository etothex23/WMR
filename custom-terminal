#!/bin/bash

# 1. Install Zsh
sudo apt update && sudo apt install -y zsh git curl

# 2. Install Oh My Zsh (Unattended mode prevents the script from stopping)
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Define custom plugin directory
ZSH_CUSTOM=${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}

# 3. Clone Plugins
git clone https://github.com/zsh-users/zsh-autosuggestions.git $ZSH_CUSTOM/plugins/zsh-autosuggestions
git clone https://github.com/zsh-users/zsh-syntax-highlighting.git $ZSH_CUSTOM/plugins/zsh-syntax-highlighting
git clone --depth 1 https://github.com/marlonrichert/zsh-autocomplete.git $ZSH_CUSTOM/plugins/zsh-autocomplete

# 4. Download Theme
# Note: Use the 'raw' GitHub URL to get the actual file content
curl -fLo "$HOME/.oh-my-zsh/themes/watermelonrobot.zsh-theme" --create-dirs \
    https://raw.githubusercontent.com/etothex23/WMR/main/watermelonrobot.zsh-theme

# 5. Update .zshrc settings
# Replaces the default theme with watermelonrobot
sed -i 's/ZSH_THEME="robbyrussell"/ZSH_THEME="watermelonrobot"/g' ~/.zshrc

# Replaces the default plugin list with your expanded list
sed -i 's/plugins=(git)/plugins=(git zsh-autocomplete zsh-autosuggestions zsh-syntax-highlighting)/g' ~/.zshrc

echo "Setup complete. Please run 'zsh' or restart your terminal."

